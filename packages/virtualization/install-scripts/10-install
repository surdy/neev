#!/usr/bin/env bash
set -euo pipefail

# ublue-os-libvirt-workarounds lives in the ublue-os/packages COPR
dnf -y copr enable ublue-os/packages
dnf -y install --setopt=install_weak_deps=False \
    cockpit-machines \
    libvirt-client \
    libvirt-daemon \
    libvirt-daemon-kvm \
    ublue-os-libvirt-workarounds \
    virt-install
dnf -y copr disable ublue-os/packages
